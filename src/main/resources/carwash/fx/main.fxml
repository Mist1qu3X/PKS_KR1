<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="carwash.fx.MainController" prefWidth="1000" prefHeight="620">

    <top>
        <VBox styleClass="toolbar-box">
            <!-- строка действий (CRUD и прочее) -->
            <HBox spacing="8" styleClass="toolbar-row">
                <Button text="Добавить" onAction="#onAdd" styleClass="btn-primary"/>
                <Button text="Редактировать" onAction="#onEdit"/>
                <Button text="Сменить статус" onAction="#onChangeStatus"/>
                <Button text="Удалить" onAction="#onDelete" styleClass="btn-danger"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Обновить" onAction="#onRefresh"/>
                <Button text="Статистика" onAction="#onStatistics"/>
                <Button text="Экспорт" onAction="#onExport"/>
            </HBox>

            <!-- строка поиска, фильтров и сортировки -->
            <HBox spacing="8" styleClass="toolbar-row">
                <Label text="Поиск:" styleClass="field-label"/>
                <TextField fx:id="searchField" promptText="гос. номер или клиент" prefWidth="220"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Статус:" styleClass="field-label"/>
                <ComboBox fx:id="statusFilter" prefWidth="150"/>
                <Label text="Услуга:" styleClass="field-label"/>
                <ComboBox fx:id="serviceFilter" prefWidth="170"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Сортировка:" styleClass="field-label"/>
                <ComboBox fx:id="sortBox" prefWidth="210"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Сбросить" onAction="#onResetFilters"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                <TableColumn fx:id="clientCol" text="Клиент" prefWidth="160"/>
                <TableColumn fx:id="carNumberCol" text="Гос. номер" prefWidth="120"/>
                <TableColumn fx:id="carModelCol" text="Модель" prefWidth="140"/>
                <TableColumn fx:id="serviceCol" text="Услуга" prefWidth="160"/>
                <TableColumn fx:id="dateCol" text="Дата и время" prefWidth="140"/>
                <TableColumn fx:id="priceCol" text="Цена, руб." prefWidth="100"/>
                <TableColumn fx:id="statusCol" text="Статус" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <Label fx:id="statusBar" styleClass="status-bar" text="Готово"/>
    </bottom>
</BorderPane>
